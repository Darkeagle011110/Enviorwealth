# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=carbon
POSTGRES_PASSWORD=carbonpass
POSTGRES_DB=carbondb
DATABASE_URL=postgresql+psycopg2://carbon:carbonpass@localhost:5432/carbondb

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Admin Authentication (C2 FIX: No more hardcoded defaults) ───────────────
# Generate a secure JWT secret key:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Admin login credentials
ADMIN_USERNAME=admin
# Generate a bcrypt hash for your chosen password:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_STRONG_PASSWORD', bcrypt.gensalt(12)).decode())"
ADMIN_PASSWORD_HASH=

# Token expiry in minutes (default 60)
JWT_EXPIRE_MINUTES=60

# ─── API Key Encryption (C3 FIX: Fernet symmetric encryption) ────────────────
# Encrypt LLM API keys at rest in the database.
# Generate a Fernet key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ─── LLM Providers (managed via Admin Panel at runtime) ──────────────────────
# These are fallback bootstrap defaults. The Admin Panel is the source of truth.
# Supported providers: claude | openai | groq | gemini

DEFAULT_LLM_PROVIDER=claude
DEFAULT_LLM_MODEL=claude-3-5-sonnet-20241022

# Claude / Anthropic
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Groq
GROQ_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# ─── Embeddings ──────────────────────────────────────────────────────────────
# Provider for generating RAG embeddings (separate from chat LLM)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
# Fallback to local sentence-transformers if OpenAI key not set
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── Frontend API URL (C4 FIX) ────────────────────────────────────────────────
# Used by Next.js frontend. Must be set in production.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── App ─────────────────────────────────────────────────────────────────────
ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
